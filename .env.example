# Copy to .env with `make env`, then fill in the values.
# README.md (Configuration) describes each variable and lists typical local values.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Django ---
SECRET_KEY=
DEBUG=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ORIGIN_WHITELIST=
DJANGO_CSRF_COOKIE_SECURE=
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SESSION_COOKIE_SECURE=
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_TIMEOUT=
FRONTEND_BASE_URL=
SHOW_DEBUG_TOOLBAR=
ENABLE_DEBUG_LOGGING=

# Superuser created when the webapp container starts
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Database connection (DB_HOST is `db` inside Docker) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Redis for the Huey worker (make tasks overrides these) ---
REDIS_HOST=
REDIS_PORT=

# --- Authentication ---
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
ALLOW_LOCAL_ACCOUNTS=

# --- External services ---
# The first migrate on an empty database calls the Route Planner; set the base
# URL without a trailing path
ROUTE_PLANNER_API_URL=
ROUTE_PLANNER_API_KEY=
OPEN511_API_URL=
OPEN511_API_KEY=
DISABLE_OPEN511_SYNC=

# --- RIDE ---
EVENT_PREFIX=
ACCESS_REQUEST_RECEIVERS=

# --- Notification and access request emails ---
DISABLE_EVENT_NOTIFICATIONS=
RIDE_NOTIFICATION_FROM_EMAIL_DEFAULT=
RIDE_NOTIFICATION_ADDRESS_BOOK_EMAIL=
RIDE_NOTIFICATION_SUBJECT_PREFIX=
RIDE_SUPPORT_EMAIL=
DRIVEBC_BASE_URL=
RIDE_USERS_STRING=
RIDE_ORGS_STRING=
TASKS_BACKEND=

# --- Windows only: paths to the GEOS, GDAL and PROJ libraries ---
# Only read when Django runs directly on Windows, outside Docker, where GeoDjango
# can't find these libraries itself. Ignored on macOS and Linux, and inside the
# webapp container on any platform. Leave blank or delete them otherwise.
GEOS_LIBRARY_PATH=
GDAL_LIBRARY_PATH=
PROJ_LIB=

# --- Release script (src/webapp/release.py) ---
TICKET_API_HOST=

# --- Frontend build: needed for the Font Awesome Pro packages ---
FONTAWESOME_PACKAGE_TOKEN=

# --- Frontend (Vite reads the VITE_ prefix) ---
VITE_API_HOST=
VITE_DEBUG=
VITE_ALLOW_LOCAL_ACCOUNTS=
VITE_GEOCODER_HOST=
VITE_GEOCODER_CLIENT_ID=
VITE_ROUTER_URL=
VITE_ROUTER_CLIENT_ID=
VITE_ROUTABLE_LOCATIONS_HOST=
VITE_BASE_MAP_URL=
VITE_MAP_STYLE_URL=
VITE_DMS_API_URL=
VITE_EVENT_POLLING_REFRESH=
VITE_CLEARING_TIMEOUT=
VITE_SHOW_DEBUG_CONTROL=
VITE_ENVIRONMENT=
